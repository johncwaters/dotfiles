[Unit]
Description=Glissa dashboard
After=network.target
# dist/ is gitignored build output; without this, a wiped build crash-loops on Restart=on-failure forever.
ConditionPathExists=__APP_DIR__/dist/server/index.js

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
ExecStart=__NODE__ dist/server/index.js
Environment=PATH=__PATH__
KillMode=control-group
TimeoutStopSec=10
LimitNOFILE=65536
TasksMax=4096
LimitNPROC=4096
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
