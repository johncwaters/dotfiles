[Unit]
Description=Glissa dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
# dist/ is gitignored build output; rebuilding at start heals a stale or wiped dist instead of crash-looping.
ExecStartPre=__NPM__ run build
ExecStart=__NODE__ dist/server/index.js
# Credentials live outside the dashboard config; the leading dash keeps a machine without the file bootable.
EnvironmentFile=-%h/.glissa/secrets.env
Environment=PATH=__PATH__
KillMode=control-group
TimeoutStopSec=10
LimitNOFILE=65536
TasksMax=4096
LimitNPROC=4096
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
