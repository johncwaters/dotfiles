[Unit]
Description=Glimmervoid dashboard
After=network.target

[Service]
Type=simple
# The memory caps live on the slice: glimmervoid gives each session its own scope only when this unit caps nothing itself.
Slice=app-glimmervoid.slice
WorkingDirectory=%h
ExecStart=%h/.glimmervoid/bin/glimmervoid
# Credentials live outside the dashboard config; the leading dash keeps a machine without the file bootable.
EnvironmentFile=-%h/.glimmervoid/secrets.env
Environment=PATH=__PATH__
KillMode=control-group
TimeoutStopSec=10
LimitNOFILE=65536
TasksMax=4096
LimitNPROC=4096
Restart=on-failure
RestartSec=5
# Without it the default OOMPolicy=stop turns one OOM-killed session into a restart that drops every live session.
OOMPolicy=continue

[Install]
WantedBy=default.target
