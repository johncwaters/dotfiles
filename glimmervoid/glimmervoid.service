[Unit]
Description=Glimmervoid dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.glimmervoid/bin/glimmervoid
# Credentials live outside the dashboard config; the leading dash keeps a machine without the file bootable.
EnvironmentFile=-%h/.glimmervoid/secrets.env
Environment=PATH=__PATH__
KillMode=control-group
TimeoutStopSec=10
LimitNOFILE=65536
TasksMax=4096
LimitNPROC=4096
Restart=on-failure
RestartSec=5
# Without it the default OOMPolicy=stop turns one OOM-killed session into a restart that drops every live session.
OOMPolicy=continue
# Sessions run builds and tests inside this cgroup; capping it reclaims here before the kernel picks victims box-wide.
MemoryHigh=50%
MemoryMax=60%

[Install]
WantedBy=default.target
