{
  "port": 3000,
  "autoRecoverSeconds": 3,
  "inputGraceSeconds": 5,
  "promptDetectionMs": 1500,
  "notifyDebounceMs": 3000,
  "repoRoots": [
    "{{HOME}}/Projects"
  ],
  "projects": [
    {
      "id": "00000000-0000-4000-8000-000000000001",
      "name": "glimmervoid",
      "path": "{{HOME}}/Projects/glimmervoid"
    }
  ],
  "replayBufferKB": 512,
  "scrollback": 50000,
  "cursorBlink": false,
  "debugMode": true,
  "teams": [],
  "hooks": [
    {
      "id": "a2ef51b3-f8f3-4d9a-ac4b-785965a85560",
      "name": "Block new code comments",
      "event": "PreToolUse",
      "type": "command",
      "enabled": true,
      "matcher": "Write|Edit|MultiEdit",
      "command": "node {{HOME}}/.claude/hooks/block-comments.mjs"
    },
    {
      "id": "4582ad94-2758-4b8a-97cb-c628e71bb80f",
      "name": "Block new else statements",
      "event": "PreToolUse",
      "type": "command",
      "enabled": true,
      "matcher": "Write|Edit|MultiEdit",
      "command": "node {{HOME}}/.claude/hooks/block-else.mjs"
    }
  ],
  "skipPermissionsByDefault": true,
  "branchGc": {
    "deleteUnmerged": true
  },
  "postTurnChecks": {
    "mode": "fix"
  }
}
