{
  "autoRecoverSeconds": 3,
  "inputGraceSeconds": 5,
  "promptDetectionMs": 1500,
  "notifyDebounceMs": 3000,
  "replayBufferKB": 512,
  "cursorBlink": false,
  "debugMode": false,
  "calmLayout": false,
  "rtk": true,
  "skipPermissionsByDefault": true,
  "repoRoots": [
    "{{HOME}}/Projects"
  ],
  "changeMap": {
    "narrator": {
      "enabled": false,
      "engine": "codex",
      "model": "gpt-6-sol"
    }
  },
  "branchGc": {
    "deleteUnmerged": true
  },
  "postTurnChecks": {
    "mode": "fix"
  },
  "visions": {
    "enabled": false,
    "dispatch": {
      "enabled": true
    }
  },
  "teamReview": {
    "enabled": true,
    "autoRebaseMyPrs": true,
    "org": "PostHog",
    "team": "team-wizard-docs",
    "reReviewAfterHours": 2,
    "skipIdleAfterDays": 14
  },
  "coherence": {
    "enabled": false
  },
  "benchmarks": {
    "enabled": true
  },
  "ingest": {
    "enabled": true,
    "sources": {
      "fs": {
        "enabled": true
      },
      "git": {
        "enabled": true
      },
      "editor": {
        "enabled": true
      },
      "terminal": {
        "enabled": true
      },
      "agentLogs": {
        "enabled": true
      },
      "shellHistory": {
        "enabled": true
      }
    }
  },
  "agentApi": {
    "enabled": true
  },
  "hooks": [
    {
      "id": "a2ef51b3-f8f3-4d9a-ac4b-785965a85560",
      "name": "Block new code comments",
      "event": "PreToolUse",
      "type": "command",
      "enabled": true,
      "matcher": "Write|Edit|MultiEdit",
      "command": "node {{HOME}}/.claude/hooks/block-comments.mjs"
    }
  ],
  "projects": [
    {
      "id": "856a1950-c603-45a0-bc82-9ef7062cec98",
      "name": "Projects",
      "path": "{{HOME}}/Projects",
      "dangerouslySkipPermissions": true
    },
    {
      "id": "06f20f9d-49ce-4b54-864e-985ee3379e3a",
      "name": "posthog.com",
      "path": "{{HOME}}/Projects/posthog.com",
      "dangerouslySkipPermissions": true
    },
    {
      "id": "1caceaa4-4b78-4b25-89c0-1092d5cb61b7",
