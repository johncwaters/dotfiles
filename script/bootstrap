#!/usr/bin/env bash

selfDirectory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
dotfilesRepo="$(cd -- "$selfDirectory/.." && pwd)"

# shellcheck source=./lib/platform.sh
source "$selfDirectory/lib/platform.sh"
# shellcheck source=./lib/profile.sh
source "$selfDirectory/lib/profile.sh"

bootstrapBashMajor="${BASH_VERSINFO[0]}"
bootstrapTestBashMajor="$(trustedPlatformTestPath "${DOTFILES_TEST_BASH_MAJOR:-}" || true)"
if [[ -n "$bootstrapTestBashMajor" ]]; then
  bootstrapBashMajor="$bootstrapTestBashMajor"
fi

findModernBootstrapBash() {
  local candidateBash
  for candidateBash in "$(homebrewPrefix)/bin/bash" /usr/local/bin/bash; do
    if [[ -x "$candidateBash" ]] && "$candidateBash" -c '((BASH_VERSINFO[0] >= 4))' >/dev/null 2>&1; then
      printf '%s\n' "$candidateBash"
      return 0
    fi
  done
  return 1
}

# Piping the download straight into bash hides curl's status, and an empty body then runs as an empty script.
installHomebrew() {
  local installerPath
  local installerUrl="https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh"
  installerPath="$(mktemp "${TMPDIR:-/tmp}/dotfiles-homebrew-install.XXXXXX")" || return 1
  if ! curl -fsSL "$installerUrl" -o "$installerPath" || [[ ! -s "$installerPath" ]]; then
    rm -f -- "$installerPath"
    printf 'bootstrap: downloading the Homebrew installer from %s failed.\n' "$installerUrl" >&2
    return 1
  fi
  if ! /bin/bash "$installerPath"; then
    rm -f -- "$installerPath"
    printf 'bootstrap: the Homebrew installer failed.\n' >&2
    return 1
  fi
  rm -f -- "$installerPath"
}

refuseUnrunnableProfile() {
  local gateProfileName="$1"
  local declaredPlatform=""
  local detectedPlatform
  local declaredPlatformStatus=0
  declaredPlatform="$(readProfilePlatform "$(profileDirectory "$gateProfileName")/profile.json")" \
    || declaredPlatformStatus=$?
  if ((declaredPlatformStatus == 1)); then
    return 0
  fi
  detectedPlatform="$(platformName)" || exit 1
  if ((declaredPlatformStatus > 1)); then
    printf 'bootstrap: profile %s declares platform "%s", but detected %s.\n' \
      "$gateProfileName" "${declaredPlatform:-unreadable}" "$detectedPlatform" >&2
    exit 1
  fi
  if [[ "$declaredPlatform" == "$detectedPlatform" ]]; then
    return 0
  fi
  printf 'bootstrap: profile %s declares platform %s, but detected %s.\n' \
    "$gateProfileName" "$declaredPlatform" "$detectedPlatform" >&2
  exit 1
}

# The gate runs before the argument parse validates anything, so this answers only for a profile the repo actually carries.
profileNameForPlatformGate() {
  local argument
  local nextArgumentIsTheProfile=0
  local gateProfileName=""
  for argument in "$@"; do
    if ((nextArgumentIsTheProfile == 1)); then
      gateProfileName="$argument"
      break
    fi
    if [[ "$argument" == "--profile" ]]; then
      nextArgumentIsTheProfile=1
    fi
  done
  if [[ -z "$gateProfileName" ]]; then
    gateProfileName="${DOTFILES_PROFILE:-}"
  fi
  if [[ -z "$gateProfileName" ]]; then
    gateProfileName="$(readMarkedProfileName)"
  fi
  if [[ -z "$gateProfileName" ]] || ! nameIsSafe "$gateProfileName"; then
    return 1
  fi
  if [[ ! -f "$(profileDirectory "$gateProfileName")/profile.json" ]]; then
    return 1
  fi
  printf '%s\n' "$gateProfileName"
}

if ((bootstrapBashMajor < 4)); then
  # This branch installs Homebrew and brew-installs bash, so a profile this machine cannot run is refused before any of that lands.
  gateProfileName="$(profileNameForPlatformGate "$@" || true)"
  if [[ -n "$gateProfileName" ]]; then
    refuseUnrunnableProfile "$gateProfileName"
  fi
  modernBootstrapBash="$(findModernBootstrapBash || true)"
  if [[ -n "$modernBootstrapBash" ]]; then
    exec "$modernBootstrapBash" "$0" "$@"
  fi
  bootstrapPlatform="$(platformName)" || exit 1
  if [[ "$bootstrapPlatform" != "darwin" ]]; then
    printf 'bootstrap: bash 4 or newer is required.\n' >&2
    exit 1
  fi
  bootstrapBrew="$(command -v brew 2>/dev/null || true)"
  if [[ -z "$bootstrapBrew" ]]; then
    installHomebrew || exit 1
    bootstrapBrew="$(homebrewPrefix)/bin/brew"
  fi
  if ! "$bootstrapBrew" install bash; then
    printf 'bootstrap: brew install bash failed.\n' >&2
    exit 1
  fi
  modernBootstrapBash="$(findModernBootstrapBash || true)"
  if [[ -z "$modernBootstrapBash" ]]; then
    printf 'bootstrap: Homebrew installed bash, but no bash 4 or newer was found.\n' >&2
    exit 1
  fi
  exec "$modernBootstrapBash" "$0" "$@"
fi

# Bash 4 starts here.
# shellcheck source=./lib/context.sh
source "$selfDirectory/lib/context.sh"

scriptStartSeconds=$SECONDS
requestedProfile=""

usage() {
  cat <<'USAGE'
Usage: script/bootstrap [--profile <name>]

Points ~/.dotfiles at this clone, resolves the machine profile, and runs that
profile's topics in the order its profile.json lists them.

The profile comes from --profile, then $DOTFILES_PROFILE, then .machine-profile.
An existing .machine-profile is never rewritten, so a differing --profile or
$DOTFILES_PROFILE applies to that one run and the machine keeps its profile.
USAGE
}

while (($# > 0)); do
  case "$1" in
    --profile)
      if (($# < 2)) || [[ -z "$2" ]]; then
        printf 'bootstrap: --profile needs a name.\n' >&2
        usage >&2
        exit 1
      fi
      requestedProfile="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      printf 'bootstrap: unknown argument %s\n' "$1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ -n "$requestedProfile" ]]; then
  profileName="$requestedProfile"
fi

if [[ -z "$profileName" ]]; then
  printf 'bootstrap: no profile. Pass --profile <name>, set $DOTFILES_PROFILE, or write %s.\n' \
    "$(profileMarkerPath)" >&2
  exit 1
fi

topicsOutput="$(resolveProfileTopics "bootstrap" "$profileName")" || exit 1
refuseUnrunnableProfile "$profileName"
profileTopics=()
if [[ -n "$topicsOutput" ]]; then
  mapfile -t profileTopics <<< "$topicsOutput"
fi
if ((${#profileTopics[@]} == 0)); then
  printf 'bootstrap: %s/profile.json lists no topics.\n' "$(profileDirectory "$profileName")" >&2
  exit 1
fi

repoIsLinkedWorktree() {
  local gitDirectory
  local gitCommonDirectory
  gitDirectory="$(git -C "$dotfilesRepo" rev-parse --git-dir 2>/dev/null)" || return 1
  gitCommonDirectory="$(git -C "$dotfilesRepo" rev-parse --git-common-dir 2>/dev/null)" || return 1
  gitDirectory="$(cd -- "$dotfilesRepo" && cd -- "$gitDirectory" && pwd -P)" || return 1
  gitCommonDirectory="$(cd -- "$dotfilesRepo" && cd -- "$gitCommonDirectory" && pwd -P)" || return 1
  [[ "$gitDirectory" != "$gitCommonDirectory" ]]
}

ensureDotfilesAlias() {
  if aliasResolvesToRepo; then
    notePresent "~/.dotfiles" "points at this clone"
    return 0
  fi
  if repoIsLinkedWorktree; then
    printf 'bootstrap: %s is a linked worktree; run bootstrap from the main checkout so %s survives worktree removal.\n' \
      "$dotfilesRepo" "$dotfilesAlias" >&2
    exit 1
  fi
  if [[ -e "$dotfilesAlias" && ! -L "$dotfilesAlias" ]]; then
    printf 'bootstrap: %s exists and is not a symlink; move it aside first.\n' "$dotfilesAlias" >&2
    exit 1
  fi
  rm -f -- "$dotfilesAlias"
  ln -s -- "$dotfilesRepo" "$dotfilesAlias"
  noteApplied "~/.dotfiles" "points at $dotfilesRepo"
}

# The commit skill reads this marker, so a one-off profile must never rewrite it.
ensureProfileMarker() {
  local markedProfile
  markedProfile="$(readMarkedProfileName)"
  if [[ -z "$markedProfile" ]]; then
    printf '%s\n' "$profileName" > "$(profileMarkerPath)"
    noteApplied ".machine-profile" "now $profileName"
    return 0
  fi
  if [[ "$markedProfile" == "$profileName" ]]; then
    notePresent ".machine-profile" "$profileName"
    return 0
  fi
  noteDetail ".machine-profile" "stays $markedProfile, $profileName applies to this run only"
}

appliedTally=0
installedTally=0
presentTally=0
warnedTally=0
failedTally=0
finishedTopicTally=0
warnedNotes=()
failedNotes=()

countNoteTokens() {
  grep -c -x -F -e "$1" -- "$countsFile" 2>/dev/null || true
}

bankNotes() {
  local notePrefix="$1"
  local -n bankedNotes="$2"
  local recordedNote
  while IFS= read -r recordedNote; do
    bankedNotes+=("$recordedNote")
  done < <(sed -n "s/^$notePrefix //p" -- "$countsFile" 2>/dev/null)
}

seedCountsFile() {
  if [[ -n "${countsFile:-}" ]]; then
    rm -f -- "$countsFile"
  fi
  countsFile="$(mktemp "${TMPDIR:-/tmp}/dotfiles-counts.XXXXXX")"
  printf 'nonce %s\n' "$countsNonce" > "$countsFile"
  useCountsFile "$countsFile"
  export DOTFILES_COUNTS_FILE="$countsFile"
}

countsFileIsOurs() {
  [[ ! -L "$countsFile" && -f "$countsFile" ]] || return 1
  [[ "$(head -n 1 -- "$countsFile" 2>/dev/null)" == "nonce $countsNonce" ]]
}

# A topic can delete or symlink the counts file, so notes are banked here and it is reseeded.
drainCountsIntoTally() {
  if ! countsFileIsOurs; then
    seedCountsFile
    noteFailed "counts" "the shared tally was lost mid run, earlier notes may be undercounted"
  fi
  appliedTally=$((appliedTally + $(countNoteTokens applied)))
  installedTally=$((installedTally + $(countNoteTokens installed)))
  presentTally=$((presentTally + $(countNoteTokens present)))
  warnedTally=$((warnedTally + $(countNoteTokens warned)))
  failedTally=$((failedTally + $(countNoteTokens failed)))
  finishedTopicTally=$((finishedTopicTally + $(countNoteTokens finished)))
  bankNotes warned-note warnedNotes
  bankNotes failed-note failedNotes
  seedCountsFile
}

countsFile=""
countsNonce="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
trap 'rm -f -- "$countsFile"' EXIT
seedCountsFile
export DOTFILES_COUNTS_NONCE="$countsNonce"
export DOTFILES_PROFILE="$profileName"

writeSection "Profile $profileName"
ensureDotfilesAlias
ensureProfileMarker
noteDetail "topics" "${profileTopics[*]}"

clearRemovedTopicUpgradeRecords() {
  [[ -n "${DOTFILES_UPGRADE:-}" ]] || return 0
  dotfilesStateDirectory || return 0
  local topicName
  local recordPath
  local recordName
  local recordedTopic
  declare -A activeTopics
  for topicName in "${profileTopics[@]}"; do
    activeTopics["$topicName"]=1
  done
  for recordPath in "$dotfilesStateDirectoryPath"/upgrades-held-* "$dotfilesStateDirectoryPath"/upgrades-failed-*-pending; do
    [[ -e "$recordPath" || -L "$recordPath" ]] || continue
    recordName="${recordPath##*/}"
    recordedTopic="${recordName#upgrades-held-}"
    if [[ "$recordName" == upgrades-failed-*-pending ]]; then
      recordedTopic="${recordName#upgrades-failed-}"
      recordedTopic="${recordedTopic%-pending}"
    fi
    [[ -z "${activeTopics[$recordedTopic]:-}" ]] || continue
    clearDotfilesState "$recordName"
  done
}

clearRemovedTopicUpgradeRecords

runTopic() {
  local topicName="$1"
  if ! nameIsSafe "$topicName"; then
    noteFailed "$topicName" "invalid topic name"
    return 0
  fi
  if ! topicIsKnown "$topicName"; then
    noteFailed "$topicName" "no such topic in this repo"
    return 0
  fi
  local warnedTallyBeforeTopic=$warnedTally
  local failedTallyBeforeTopic=$failedTally
  local finishedTopicTallyBeforeTopic=$finishedTopicTally
  local topicStatus=0
  DOTFILES_UPGRADE_TOPIC="$topicName" "$BASH" "$dotfilesRepo/$topicName/install.sh" || topicStatus=$?
  drainCountsIntoTally
  if ((topicStatus == 0)); then
    return 0
  fi
  if ((failedTally > failedTallyBeforeTopic)); then
    return 0
  fi
  if ((finishedTopicTally > finishedTopicTallyBeforeTopic && warnedTally > warnedTallyBeforeTopic)); then
    return 0
  fi
  noteFailed "$topicName" "install.sh exited $topicStatus before finishing"
}

# The first darwin converge installs Homebrew's bash during this run, so PATH still answers bash with the 3.2 a topic cannot use.
putRunningBashFirstOnPath() {
  local runningBashDirectory="${BASH%/*}"
  if [[ ! -d "$runningBashDirectory" || ":$PATH:" == *":$runningBashDirectory:"* ]]; then
    return 0
  fi
  PATH="$runningBashDirectory:$PATH"
  export PATH
  hash -r 2>/dev/null || true
}

putRunningBashFirstOnPath

for topicName in "${profileTopics[@]}"; do
  writeSection "$topicName"
  runTopic "$topicName"
  drainCountsIntoTally
done

convergedStateName="converged"

convergedCommit() {
  git -C "$dotfilesRepo" rev-parse HEAD 2>/dev/null || printf 'unknown\n'
}

recordConverge() {
  local outcome="clean"
  # A dirty converge renders content that no later commit accounts for, so the record must outlive the edit.
  if [[ -n "$(git -C "$dotfilesRepo" status --porcelain 2>/dev/null)" ]]; then
    outcome="dirty"
  fi
  if ((warnedTally != 0)); then
    outcome="warned"
  fi
  if ((failedTally != 0)); then
    outcome="failed"
  fi
  writeDotfilesState "$convergedStateName" \
    "$(convergedCommit) $profileName $(date -u +%Y-%m-%dT%H:%M:%SZ) $outcome"
}

# Before the summary: a refused record warns, and after the tally is banked nothing would count it.
recordConverge
drainCountsIntoTally

writeSummary "$((SECONDS - scriptStartSeconds))" \
  "$appliedTally" \
  "$installedTally" \
  "$presentTally" \
  "$warnedTally" \
  "$failedTally"
writeRecap "Warnings" "warn" "$colorYellow" "${warnedNotes[@]+"${warnedNotes[@]}"}"
writeRecap "Failures" "fail" "$colorRed" "${failedNotes[@]+"${failedNotes[@]}"}"

if ((failedTally != 0)); then
  exit 1
fi
