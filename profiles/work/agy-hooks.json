{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(write_file|edit_file|create_file|replace_file_content|multi_replace_file_content)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/profile-hooks/require-worktree.mjs\" --agent=agy",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
