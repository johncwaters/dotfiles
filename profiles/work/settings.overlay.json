{
  "worktree": { "baseRef": "fresh" },
  "disabledMcpjsonServers": ["posthog-local", "trunk"],
  "enabledPlugins": {
    "cloudflare@cloudflare": false
  },
  "extraKnownMarketplaces": {
    "cloudflare": { "source": { "source": "github", "repo": "cloudflare/skills" } }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__.*__exec$",
        "hooks": [{ "type": "command", "command": "node {{HOME}}/.claude/profile-hooks/gate-posthog-exec-write.mjs" }]
      }
    ]
  },
  "switchModelsOnFlag": false
}
