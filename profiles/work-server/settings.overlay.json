{
  "worktree": {
    "baseRef": "fresh"
  },
  "enabledPlugins": {
    "posthog@claude-plugins-official": false,
    "slack@claude-plugins-official": false,
    "cloudflare@cloudflare": false
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|Skill|mcp__.*cloudflare.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/profile-hooks/confine-cloudflare.mjs"
          }
        ]
      },
      {
        "matcher": "^mcp__.*__exec$",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/profile-hooks/gate-posthog-exec-write.mjs"
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "switchModelsOnFlag": false
}
