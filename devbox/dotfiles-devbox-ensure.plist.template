<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.dotfiles.devbox.ensure</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{BASH}}</string>
    <string>-c</string>
    <string>source "$0"; devbox "$@"</string>
    <string>{{HOME}}/.dotfiles/devbox/commands.bash</string>
    <string>ensure</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{BREW}}/bin:{{BREW}}/sbin:{{HOME}}/.npm-global/bin:{{HOME}}/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>DEVBOX_LOG_PATH</key>
    <string>{{STATE}}/devbox-ensure.log</string>
  </dict>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{STATE}}/devbox-ensure.log</string>
  <key>StandardErrorPath</key>
  <string>{{STATE}}/devbox-ensure.log</string>
</dict>
</plist>
