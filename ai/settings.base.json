{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_COMMIT_POLICY_ROOT": "{{HOME}}/.dotfiles",
    "CAVEMAN_DEFAULT_MODE": "ultra"
  },
  "model": "claude-opus-5-5[1m]",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "permissions": {
    "allow": [
      "Workflow(plan-challenge)",
      "Workflow(qa-swarm)"
    ],
    "deny": [
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Gmail__trash_message",
      "mcp__claude_ai_Gmail__trash_thread",
      "mcp__claude_ai_Gmail__mark_message_spam",
      "mcp__claude_ai_Gmail__mark_thread_spam",
      "mcp__claude_ai_Gmail__delete_label",
      "mcp__claude_ai_Google_Calendar__delete_event",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__plugin_slack_slack__slack_add_list_record",
      "mcp__plugin_slack_slack__slack_add_reaction",
      "mcp__plugin_slack_slack__slack_complete_file_upload",
      "mcp__plugin_slack_slack__slack_create_canvas",
      "mcp__plugin_slack_slack__slack_create_conversation",
      "mcp__plugin_slack_slack__slack_create_list",
      "mcp__plugin_slack_slack__slack_schedule_message",
      "mcp__plugin_slack_slack__slack_send_message",
      "mcp__plugin_slack_slack__slack_update_canvas",
      "mcp__plugin_slack_slack__slack_update_list",
      "mcp__plugin_slack_slack__slack_update_list_record",
      "Bash(git *push* --force)",
      "Bash(git *push* --force *)",
      "Bash(git *push* -f*)",
      "Bash(git *push* +*)",
      "Bash(git *push* --mirror*)",
      "Bash(git *stash)",
      "Bash(git *stash -*)",
      "Bash(git *stash save*)",
      "Bash(git *stash pop*)",
      "Bash(git *stash drop*)",
      "Bash(git *stash clear*)",
      "Bash(npm pub*)",
      "Bash(npm -* pub*)",
      "Bash(gh repo delete*)",
      "Bash(gh auth token*)",
      "Bash(gh auth status* --show-token*)",
      "Bash(gh auth status* -t*)",
      "Bash(gh config get* oauth_token*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.glimmervoid/config.json*)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/validate-file.mjs"
          }
        ]
      },
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/enforce-spawn-model.mjs"
          }
        ]
      },
      {
        "matcher": "^(Bash|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/gate-codex-dispatch.mjs"
          }
        ]
      },
      {
        "matcher": "^ExitPlanMode$",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/challenge-plan.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/check-finding-scope.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/inject-routing.mjs"
          },
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/caveman-ultra.mjs"
          },
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/report-parked-branches.mjs"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node {{HOME}}/.claude/hud/hud.mjs"
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true
}
