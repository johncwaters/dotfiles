{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_COMMIT_POLICY_ROOT": "{{HOME}}/.dotfiles",
    "CAVEMAN_DEFAULT_MODE": "ultracave",
    "CAVEMAN_TELEMETRY": "0",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5"
  },
  "model": "claude-opus-5-5[1m]",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "cc-plugin-diff@builtin": false
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "permissions": {
    "allow": [
      "Workflow(plan-challenge)",
      "Workflow(qa-swarm)"
    ],
    "deny": [
      "EnterPlanMode",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Gmail__trash_message",
      "mcp__claude_ai_Gmail__trash_thread",
      "mcp__claude_ai_Gmail__mark_message_spam",
      "mcp__claude_ai_Gmail__mark_thread_spam",
      "mcp__claude_ai_Gmail__delete_label",
      "mcp__claude_ai_Google_Calendar__delete_event",
      "mcp__claude_ai_Slack__slack_send_message",
      "Bash(git *push* --force)",
      "Bash(git *push* --force *)",
      "Bash(git *push* -f*)",
      "Bash(git *push* +*)",
      "Bash(git *push* --mirror*)",
      "Bash(git *stash)",
      "Bash(git *stash -*)",
      "Bash(git *stash save*)",
      "Bash(git *stash push*)",
      "Bash(git *stash pop*)",
      "Bash(git *stash drop*)",
      "Bash(git *stash clear*)",
      "Bash(npm pub*)",
      "Bash(npm -* pub*)",
      "Bash(gh repo delete*)",
      "Bash(gh auth token*)",
      "Bash(gh auth status* --show-token*)",
      "Bash(gh auth status* -t*)",
      "Bash(gh config get* oauth_token*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/validate-file.mjs"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/validate-spec.mjs"
          }
        ]
      },
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/enforce-spawn-model.mjs"
          }
        ]
      },
      {
        "matcher": "^(Bash|Write|Edit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/guard-workflow.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Read$",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/load-agents-md.mjs"
          }
        ]
      },
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/check-finding-scope.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/inject-routing.mjs"
          },
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/load-agents-md.mjs"
          },
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/report-parked-branches.mjs"
          },
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/retro-reminder.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/require-commit-on-stop.mjs"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node {{HOME}}/.claude/hooks/retro-reminder.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node {{HOME}}/.claude/hud/hud.mjs"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "node {{HOME}}/.claude/hud/subagent-hud.mjs"
  },
  "autoCompactWindow": 300000,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true
}
