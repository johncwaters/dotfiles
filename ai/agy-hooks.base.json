{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(write_file|edit_file|create_file|replace_file_content|multi_replace_file_content)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/validate-file.mjs\" --agent=agy",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/validate-spec.mjs\" --agent=agy",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/block-else.mjs\" --agent=agy",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/block-use-effect.mjs\" --agent=agy",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/block-button-labels.mjs\" --agent=agy",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/block-fixed-sleep.mjs\" --agent=agy",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/block-suppressions.mjs\" --agent=agy",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/block-comments.mjs\" --agent=agy",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/block-vague-names.mjs\" --agent=agy",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/guard-workflow.mjs\" --agent=agy",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^invoke_subagent$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/enforce-spawn-model.mjs\" --agent=agy",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(run_command|ask_question)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/guard-workflow.mjs\" --agent=agy",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node \"{{HOME}}/.claude/hooks/require-commit-on-stop.mjs\" --agent=agy",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "node \"{{HOME}}/.claude/hooks/require-carbon-unit.mjs\" --agent=agy",
        "timeout": 30
      }
    ]
  }
}
