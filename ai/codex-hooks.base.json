{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/validate-file.mjs\" --agent=codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/validate-spec.mjs\" --agent=codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/block-else.mjs\" --agent=codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/block-use-effect.mjs\" --agent=codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/block-button-labels.mjs\" --agent=codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/block-fixed-sleep.mjs\" --agent=codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/guard-workflow.mjs\" --agent=codex",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^spawn_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/enforce-spawn-model.mjs\" --agent=codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/guard-workflow.mjs\" --agent=codex",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/require-commit-on-stop.mjs\" --agent=codex",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/require-carbon-unit.mjs\" --agent=codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
