{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/block-else.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/block-use-effect.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/block-button-labels.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/block-fixed-sleep.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
