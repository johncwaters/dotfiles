<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.dotfiles.converge</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{BASH}}</string>
    <string>-c</string>
    <string>sleep 600; exec "$0" "$1"</string>
    <string>{{BASH}}</string>
    <string>{{HOME}}/.dotfiles/bin/dot</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DOTFILES_CONVERGE_AGENT</key>
    <string>1</string>
    <key>DOTFILES_REQUIRE_ORIGIN</key>
    <string>1</string>
    <key>DOTFILES_UPGRADE</key>
    <string>1</string>
    <key>NO_COLOR</key>
    <string>1</string>
    <key>PATH</key>
    <string>{{BREW}}/bin:{{BREW}}/sbin:{{HOME}}/.npm-global/bin:{{HOME}}/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <!-- Runs ten minutes after each login, standing in for the timer's OnBootSec; with no calendar slot, sleep and wake alone never trigger a converge. -->
  <key>StandardOutPath</key>
  <string>{{STATE}}/converge.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>{{STATE}}/converge.stderr.log</string>
</dict>
</plist>
