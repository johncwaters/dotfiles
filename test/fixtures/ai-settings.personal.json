{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_COMMIT_POLICY_ROOT": "/fixture/home/.dotfiles",
    "CAVEMAN_DEFAULT_MODE": "ultra"
  },
  "model": "claude-fable-5-1[1m]",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "typescript-lsp@claude-plugins-official": true,
    "posthog@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "postiz@skills-dir": false
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "permissions": {
    "allow": [
      "Read(~/.claude/workflows/**)",
      "Bash(node:*)",
      "Bash(ls:*)",
      "WebFetch(domain:unpkg.com)"
    ],
    "deny": [
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Gmail__trash_message",
      "mcp__claude_ai_Gmail__trash_thread",
      "mcp__claude_ai_Gmail__mark_message_spam",
      "mcp__claude_ai_Gmail__mark_thread_spam",
      "mcp__claude_ai_Gmail__delete_label",
      "mcp__claude_ai_Google_Calendar__delete_event",
      "mcp__claude_ai_Slack__slack_send_message",
      "Bash(git *push* --force)",
      "Bash(git *push* --force *)",
      "Bash(git *push* -f*)",
      "Bash(git *push* +*)",
      "Bash(git *push* --mirror*)",
      "Bash(git *stash)",
      "Bash(git *stash -*)",
      "Bash(git *stash save*)",
      "Bash(git *stash pop*)",
      "Bash(git *stash drop*)",
      "Bash(git *stash clear*)",
      "Bash(npm pub*)",
      "Bash(npm -* pub*)",
      "Bash(gh repo delete*)",
      "Bash(gh auth token*)",
      "Bash(gh auth status* --show-token*)",
      "Bash(gh auth status* -t*)",
      "Bash(gh config get* oauth_token*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.glimmervoid/config.json*)",
      "Read(~/.ssh/**)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node /fixture/home/.claude/hooks/validate-file.mjs"
          }
        ]
      },
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "node /fixture/home/.claude/hooks/enforce-spawn-model.mjs"
          }
        ]
      },
      {
        "matcher": "^(Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash|WebFetch|WebSearch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node /fixture/home/.claude/hooks/enforce-fable-delegation.mjs"
          }
        ]
      },
      {
        "matcher": "^ExitPlanMode$",
        "hooks": [
          {
            "type": "command",
            "command": "node /fixture/home/.claude/hooks/challenge-plan.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "node /fixture/home/.claude/hooks/check-finding-scope.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /fixture/home/.claude/hooks/inject-routing.mjs"
          },
          {
            "type": "command",
            "command": "node /fixture/home/.claude/hooks/caveman-ultra.mjs"
          },
          {
            "type": "command",
            "command": "node /fixture/home/.claude/hooks/report-parked-branches.mjs"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node /fixture/home/.claude/hud/hud.mjs"
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "theme": "auto"
}
